# Backend Configuration
# Set to 'offline' for 100% free built-in statutory reasoning (no API key needed)
# Set to 'openai' if you want to use an OpenAI API key
LLM_PROVIDER=offline

# Optional OpenAI settings (leave empty if using LLM_PROVIDER=offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Vector store and retrieval
CHROMA_PATH=./vector_store
ALLOW_UNVERIFIED_CONTEXT=false
CORS_ORIGINS=*
